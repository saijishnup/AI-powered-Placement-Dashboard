# Any OpenAI-compatible endpoint. Switching provider = edit this file only.
# Primary (dev: OmniRoute gateway on localhost; demo later: OpenRouter meta/muse-spark-1.3-contributor)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
# Comma list via OmniRoute, tried in order when a model errors or fails citation validation.
# All rate limited? Add providers in the OmniRoute dashboard and append their models here.
LLM_MODEL=gemini/gemini-3.1-flash-lite,openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b,gemini/gemini-3.1-pro-preview,groq/openai/gpt-oss-120b@low,ddgw/mistral-small-2603
# Sent to every model unless it has its own @effort in LLM_MODEL. "none" stops hidden reasoning eating the token caps.
LLM_REASONING_EFFORT=none
# Seed Stage B: comma list, round-robin
SEED_MODEL=groq/openai/gpt-oss-120b@low,codestral/codestral-latest,ddgw/mistral-small-2603
